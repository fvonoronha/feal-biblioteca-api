{
    "name": "Feal Biblioteca API",
    "version": "1.0.0",
    "private": true,
    "description": "API da Biblioteca digital da Fraternidade Espírita Amor e Luz - FEAL",
    "main": "server.js",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "start": "cross-env NODE_OPTIONS=--openssl-legacy-provider node server.js",
        "dev": "cross-env NODE_OPTIONS=--openssl-legacy-provider nodemon server.js -ext js,json,env,proto,prisma",
        "prisma:validate": "prisma validate",
        "prisma:generate": "prisma generate"
    },
    "keywords": [
        "FEAL",
        "Biblioteca"
    ],
    "author": "Scient1st",
    "license": "Apache-2.0",
    "dependencies": {
        "@aws-sdk/client-s3": "^3.1134.0",
        "@google/generative-ai": "^0.24.1",
        "@prisma/client": "^6.19.2",
        "bcrypt": "^6.0.0",
        "cors": "^2.8.6",
        "cross-env": "^10.1.0",
        "dotenv": "^17.3.1",
        "express": "^5.2.1",
        "express-rate-limit": "^8.2.1",
        "helmet": "^8.1.0",
        "json-bigint-patch": "^0.0.9",
        "jsonwebtoken": "^9.0.3",
        "multer": "^2.4.0",
        "node-cron": "^4.2.1",
        "nodemailer": "^9.1.1",
        "nodemon": "^3.1.14",
        "sharp": "^0.35.4",
        "short-unique-id": "^5.3.2",
        "ua-parser-js": "^2.0.9",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "globals": "^17.4.0",
        "prisma": "^6.19.2"
    }
}
