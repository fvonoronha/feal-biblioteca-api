generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE")
}

enum SexEnum {
  M // Masculino
  F // Feminino
  N // Outro
}

enum UserRole {
  ADMIN // Administrador
  LIBRARIAN // Bibliotecário
  MEMBER // Membro
}

enum StatusEnum {
  A // ativo
  I // inativo
  E // Expirado
  D // Deletado (soft delete)

  V // Vanished (hard delete)
}

model User {
  id           BigInt     @id() @unique() @default(autoincrement())
  slug         String     @unique() @default(uuid())
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  name         String
  display_name String
  sex          SexEnum?
  login        String     @unique()
  status       StatusEnum @default(A)
  password     String
  email        String     @unique()
  role         UserRole

  auth_tokens            UserAuthToken[] @relation(name: "UserAuthToken_User")
  created_authors        Author[]        @relation(name: "Author_User_created_by_user_id")
  updated_authors        Author[]        @relation(name: "Author_User_updated_by_user_id")
  created_books          Book[]          @relation(name: "Book_User_created_by_user_id")
  updated_books          Book[]          @relation(name: "Book_User_updated_by_user_id")
  created_volumes        Volume[]        @relation(name: "Volume_User_created_by_user_id")
  updated_volumes        Volume[]        @relation(name: "Volume_User_updated_by_user_id")
  created_book_authors   VolumeAuthor[]  @relation(name: "VolumeAuthor_User_created_by_user_id")
  updated_volume_authors VolumeAuthor[]  @relation(name: "VolumeAuthor_User_updated_by_user_id")
  created_tags           Tag[]           @relation(name: "Tag_User_created_by_user_id")
  updated_tags           Tag[]           @relation(name: "Tag_User_updated_by_user_id")
  created_publishers     Publisher[]     @relation(name: "Publisher_User_created_by_user_id")
  updated_publishers     Publisher[]     @relation(name: "Publisher_User_updated_by_user_id")
  created_book_tags      BookTag[]       @relation(name: "BookTag_User_created_by_user_id")
  updated_book_tags      BookTag[]       @relation(name: "BookTag_User_updated_by_user_id")
  created_categories     Category[]      @relation(name: "Category_User_created_by_user_id")
  updated_categories     Category[]      @relation(name: "Category_User_updated_by_user_id")
  volume_accesses        VolumeAccess[]  @relation(name: "VolumeAccess_User_created_by_user_id")

  @@index([login])
  @@index([status])
  @@index([email])
  @@map("user")
}

model UserAuthToken {
  id           BigInt     @id() @unique() @default(autoincrement())
  slug         String     @unique() @default(uuid())
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?  @db.Timestamptz(6)
  last_used_at DateTime?  @db.Timestamptz(6)
  created_ip   String
  last_used_ip String?
  status       StatusEnum @default(A)
  jwt_token    String
  jwt_secret   String
  keep         Boolean    @default(false)
  user_id      BigInt

  user User @relation(fields: [user_id], references: [id], name: "UserAuthToken_User")

  @@index([created_at])
  @@index([updated_at])
  @@index([last_used_at])
  @@index([jwt_token])
  @@index([jwt_secret])
  @@index([status])
  @@index([keep])
  @@map("user_auth_token")
}

model Author {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  name               String
  search_name        String?
  status             StatusEnum @default(A)
  description        String?
  avatar_url         String?
  is_spirit          Boolean    @default(false)

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Author_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Author_User_updated_by_user_id")

  volumes VolumeAuthor[] @relation(name: "VolumeAuthor_Author_author_id")

  @@index([status])
  @@index([is_spirit])
  @@index([name])
  @@index([search_name])
  @@map("author")
}

model VolumeAuthor {
  id                 BigInt    @id() @unique() @default(autoincrement())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime? @db.Timestamptz(6)
  updated_by_user_id BigInt?

  status StatusEnum @default(A)

  author_id   BigInt
  volume_id   BigInt
  description String?

  created_by_user User   @relation(fields: [created_by_user_id], references: [id], name: "VolumeAuthor_User_created_by_user_id")
  updated_by_user User?  @relation(fields: [updated_by_user_id], references: [id], name: "VolumeAuthor_User_updated_by_user_id")
  author          Author @relation(fields: [author_id], references: [id], name: "VolumeAuthor_Author_author_id")
  volume          Volume @relation(fields: [volume_id], references: [id], name: "VolumeAuthor_Volume_volume_id")

  @@index([status])
  @@index([author_id])
  @@index([volume_id])
  @@map("volume_author")
}

model Tag {
  id                 BigInt    @id() @unique() @default(autoincrement())
  slug               String    @unique() @default(uuid())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime? @db.Timestamptz(6)
  updated_by_user_id BigInt?

  name        String
  search_name String?
  status      StatusEnum @default(A)
  description String?

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Tag_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Tag_User_updated_by_user_id")

  books BookTag[] @relation(name: "BookTag_Tag_tag_id")

  @@index([status])
  @@index([name])
  @@index([search_name])
  @@map("tag")
}

model BookTag {
  id                 BigInt     @id() @unique() @default(autoincrement())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  status             StatusEnum @default(A)

  tag_id  BigInt
  book_id BigInt

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "BookTag_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "BookTag_User_updated_by_user_id")
  tag             Tag   @relation(fields: [tag_id], references: [id], name: "BookTag_Tag_tag_id")
  book            Book  @relation(fields: [book_id], references: [id], name: "BookTag_Book_book_id")

  @@index([status])
  @@index([tag_id])
  @@index([book_id])
  @@map("book_tag")
}

model Category {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  name               String
  search_name        String?
  status             StatusEnum @default(A)
  description        String?

  created_by_user User   @relation(fields: [created_by_user_id], references: [id], name: "Category_User_created_by_user_id")
  updated_by_user User?  @relation(fields: [updated_by_user_id], references: [id], name: "Category_User_updated_by_user_id")
  books           Book[] @relation(name: "Book_Category_category_id")

  @@index([status])
  @@index([name])
  @@index([search_name])
  @@map("category")
}

model Publisher {
  id                 BigInt    @id() @unique() @default(autoincrement())
  slug               String    @unique() @default(uuid())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime? @db.Timestamptz(6)
  updated_by_user_id BigInt?

  name         String
  search_name  String?
  abbreviation String?
  status       StatusEnum @default(A)
  description  String?
  avatar_url   String?

  created_by_user User     @relation(fields: [created_by_user_id], references: [id], name: "Publisher_User_created_by_user_id")
  updated_by_user User?    @relation(fields: [updated_by_user_id], references: [id], name: "Publisher_User_updated_by_user_id")
  volumes         Volume[] @relation(name: "Volume_Publisher_publisher_id")

  @@index([status])
  @@index([name])
  @@index([search_name])
  @@index([abbreviation])
  @@map("publisher")
}

model Book {
  id                                 BigInt     @id() @unique() @default(autoincrement())
  slug                               String     @unique() @default(uuid())
  created_at                         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id                 BigInt
  updated_at                         DateTime?  @db.Timestamptz(6)
  updated_by_user_id                 BigInt?
  category_id                        BigInt?
  title                              String
  search_title                       String? // regexp_replace(lower(unaccent(title)), '[^a-z0-9]', '', 'g')
  subtitle                           String?
  search_subtitle                    String? // regexp_replace(lower(unaccent(title)), '[^a-z0-9]', '', 'g')
  summary                            String?
  description                        String?
  recommended_for                    String?
  keywords                           String[]
  status                             StatusEnum @default(A)
  last_month_access_count            BigInt     @default(0)
  last_month_access_count_updated_at DateTime?  @db.Timestamptz(6)
  all_time_access_count              BigInt     @default(0)
  all_time_access_count_updated_at   DateTime?  @db.Timestamptz(6)
  last_week_access_count             BigInt     @default(0)
  last_week_access_count_updated_at  DateTime?  @db.Timestamptz(6)

  created_by_user User      @relation(fields: [created_by_user_id], references: [id], name: "Book_User_created_by_user_id")
  updated_by_user User?     @relation(fields: [updated_by_user_id], references: [id], name: "Book_User_updated_by_user_id")
  category        Category? @relation(fields: [category_id], references: [id], name: "Book_Category_category_id")
  tags            BookTag[] @relation(name: "BookTag_Book_book_id")

  @@index([search_title])
  @@index([search_subtitle])
  @@index([status])
  @@index([title])
  @@index([subtitle])
  @@index([keywords])
  @@index([last_month_access_count])
  @@index([all_time_access_count])
  @@index([last_week_access_count])
  @@map("book")
}

model Volume {
  id                                 BigInt     @id() @unique() @default(autoincrement())
  slug                               String     @unique() @default(uuid())
  created_at                         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id                 BigInt
  updated_at                         DateTime?  @db.Timestamptz(6)
  updated_by_user_id                 BigInt?
  book_id                            BigInt
  publisher_id                       BigInt?
  year                               Int?
  edition                            String?
  isbn_old                           String?
  isbn                               String?
  pages                              Int?
  description                        String?
  pdf_url                            String?
  cover_url                          String?
  back_url                           String?
  images_url                         String[]
  keywords                           String[]
  label                              String?
  shelf                              String?
  status                             StatusEnum @default(A)
  last_week_access_count             BigInt     @default(0)
  last_week_access_count_updated_at  DateTime?  @db.Timestamptz(6)
  last_month_access_count            BigInt     @default(0)
  last_month_access_count_updated_at DateTime?  @db.Timestamptz(6)
  all_time_access_count              BigInt     @default(0)
  all_time_access_count_updated_at   DateTime?  @db.Timestamptz(6)

  created_by_user User           @relation(fields: [created_by_user_id], references: [id], name: "Volume_User_created_by_user_id")
  updated_by_user User?          @relation(fields: [updated_by_user_id], references: [id], name: "Volume_User_updated_by_user_id")
  publisher       Publisher?     @relation(fields: [publisher_id], references: [id], name: "Volume_Publisher_publisher_id")
  authors         VolumeAuthor[] @relation(name: "VolumeAuthor_Volume_volume_id")
  accesses        VolumeAccess[] @relation(name: "VolumeAccess_Volume_volume_id")

  @@index([status])
  @@index([year])
  @@index([edition])
  @@index([isbn_old])
  @@index([isbn])
  @@index([pages])
  @@index([label])
  @@index([shelf])
  @@index([keywords])
  @@index([last_month_access_count])
  @@index([all_time_access_count])
  @@index([last_week_access_count])
  @@map("volume")
}

model VolumeAccess {
  id                 BigInt     @id() @unique() @default(autoincrement())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt?
  volume_id          BigInt?
  ip_address         String?
  user_agent         String? // Question: Is it worth it to save this?
  browser_name       String?
  browser_version    String?
  os_name            String?
  os_version         String?
  device_name        String?
  device_vendor      String?
  status             StatusEnum @default(A)

  created_by_user User?   @relation(fields: [created_by_user_id], references: [id], name: "VolumeAccess_User_created_by_user_id")
  volume          Volume? @relation(fields: [volume_id], references: [id], name: "VolumeAccess_Volume_volume_id")

  @@index([created_by_user_id])
  @@index([volume_id])
  @@index([created_at])
  @@index([volume_id, created_at])
  @@map("volume_access")
}

/**
 * Observações
 */

// Quando uma nova tabela for criada rodar o migrate em 3 etapas:
// 1 > npx prisma migrate dev --name [NOME_AQUI] --schema ./prisma/schema.prisma --create-only
// 2 > [alterações manuais no migration file] 
// 3 > npx prisma migrate dev

// Quando nenhuma tabela for criada rodar o migrate em 1 etapa:
// 1 > npx prisma migrate dev --name [NOME_AQUI] --schema ./prisma/schema.prisma

