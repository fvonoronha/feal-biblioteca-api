generator client {
  provider = "prisma-client-js"
  output   = "./generated"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE")
}

enum SexEnum {
  M // Masculino
  F // Feminino
  N // Outro
}

enum UserRole {
  ADMIN // Administrador
  LIBRARIAN // Bibliotecário
  MEMBER // Membro
}

enum StatusEnum {
  A // ativo
  I // inativo
  E // Expirado
  D // Deletado (soft delete)

  V // Vanished (hard delete)
}

model User {
  id           BigInt     @id() @unique() @default(autoincrement())
  slug         String     @unique() @default(uuid())
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  name         String
  display_name String
  sex          SexEnum?
  login        String     @unique()
  status       StatusEnum @default(A)
  password     String
  email        String     @unique()
  role         UserRole

  auth_tokens          UserAuthToken[] @relation(name: "UserAuthToken_User")
  created_authors      Author[]        @relation(name: "Author_User_created_by_user_id")
  updated_authors      Author[]        @relation(name: "Author_User_updated_by_user_id")
  created_books        Book[]          @relation(name: "Book_User_created_by_user_id")
  updated_books        Book[]          @relation(name: "Book_User_updated_by_user_id")
  created_book_authors BookAuthor[]    @relation(name: "BookAuthor_User_created_by_user_id")
  updated_book_authors BookAuthor[]    @relation(name: "BookAuthor_User_updated_by_user_id")
  created_tags         Tag[]           @relation(name: "Tag_User_created_by_user_id")
  updated_tags         Tag[]           @relation(name: "Tag_User_updated_by_user_id")
  created_book_tags    BookTag[]       @relation(name: "BookTag_User_created_by_user_id")
  updated_book_tags    BookTag[]       @relation(name: "BookTag_User_updated_by_user_id")
  created_loans        Loan[]          @relation(name: "Loan_User_created_by_user_id")
  updated_loans        Loan[]          @relation(name: "Loan_User_updated_by_user_id")
  user_loans           Loan[]          @relation(name: "Loan_User_user_id")

  @@index([login])
  @@index([status])
  @@index([email])
  @@map("user")
}

model UserAuthToken {
  id           BigInt     @id() @unique() @default(autoincrement())
  slug         String     @unique() @default(uuid())
  created_at   DateTime   @default(now()) @db.Timestamptz(6)
  updated_at   DateTime?  @db.Timestamptz(6)
  last_used_at DateTime?  @db.Timestamptz(6)
  created_ip   String
  last_used_ip String?
  status       StatusEnum @default(A)
  jwt_token    String
  jwt_secret   String
  keep         Boolean    @default(false)
  user_id      BigInt

  user User @relation(fields: [user_id], references: [id], name: "UserAuthToken_User")

  @@index([created_at])
  @@index([updated_at])
  @@index([last_used_at])
  @@index([jwt_token])
  @@index([jwt_secret])
  @@index([status])
  @@index([keep])
  @@map("user_auth_token")
}

model Author {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  name               String
  status             StatusEnum @default(A)
  description        String?
  avatar_url         String?
  is_spirit          Boolean    @default(false)

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Author_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Author_User_updated_by_user_id")

  books BookAuthor[] @relation(name: "BookAuthor_Author_author_id")

  @@index([status])
  @@index([is_spirit])
  @@index([name])
  @@map("author")
}

model BookAuthor {
  id                 BigInt    @id() @unique() @default(autoincrement())
  slug               String    @unique() @default(uuid())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime? @db.Timestamptz(6)
  updated_by_user_id BigInt?

  status StatusEnum @default(A)

  author_id   BigInt
  book_id     BigInt
  description String?

  created_by_user User   @relation(fields: [created_by_user_id], references: [id], name: "BookAuthor_User_created_by_user_id")
  updated_by_user User?  @relation(fields: [updated_by_user_id], references: [id], name: "BookAuthor_User_updated_by_user_id")
  author          Author @relation(fields: [author_id], references: [id], name: "BookAuthor_Author_author_id")
  book            Book   @relation(fields: [book_id], references: [id], name: "BookAuthor_Book_book_id")

  @@index([status])
  @@index([author_id])
  @@index([book_id])
  @@map("book_author")
}

model Tag {
  id                 BigInt    @id() @unique() @default(autoincrement())
  slug               String    @unique() @default(uuid())
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime? @db.Timestamptz(6)
  updated_by_user_id BigInt?

  name        String
  status      StatusEnum @default(A)
  description String?

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Tag_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Tag_User_updated_by_user_id")

  books BookTag[] @relation(name: "BookTag_Tag_tag_id")

  @@index([status])
  @@index([name])
  @@map("tag")
}

model BookTag {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  status             StatusEnum @default(A)

  tag_id  BigInt
  book_id BigInt

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "BookTag_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "BookTag_User_updated_by_user_id")
  tag             Tag   @relation(fields: [tag_id], references: [id], name: "BookTag_Tag_tag_id")
  book            Book  @relation(fields: [book_id], references: [id], name: "BookTag_Book_book_id")

  @@index([status])
  @@index([tag_id])
  @@index([book_id])
  @@map("book_tag")
}

model Book {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  title              String
  subtitle           String?
  publisher          String?
  year               Int?
  edition            String?
  isbn               String?
  pages              Int?
  summary            String?
  pdf_url            String?
  cover_url          String?
  images_url         String[]
  label              String?
  shelf              String?
  status             StatusEnum @default(A)
  description        String?

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Book_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Book_User_updated_by_user_id")

  authors BookAuthor[] @relation(name: "BookAuthor_Book_book_id")
  tags    BookTag[]    @relation(name: "BookTag_Book_book_id")
  loans   Loan[]       @relation(name: "Loan_Book_book_id")

  @@index([status])
  @@index([title])
  @@index([subtitle])
  @@index([publisher])
  @@index([year])
  @@index([edition])
  @@index([isbn])
  @@index([pages])
  @@index([summary])
  @@index([label])
  @@index([shelf])
  @@map("book")
}

model Loan {
  id                 BigInt     @id() @unique() @default(autoincrement())
  slug               String     @unique() @default(uuid())
  created_at         DateTime   @default(now()) @db.Timestamptz(6)
  created_by_user_id BigInt
  updated_at         DateTime?  @db.Timestamptz(6)
  updated_by_user_id BigInt?
  status             StatusEnum @default(A)
  loan_date          DateTime   @default(now()) @db.Timestamptz(6)
  due_date           DateTime   @default(now()) @db.Timestamptz(6)
  return_date        DateTime?  @default(now()) @db.Timestamptz(6)
  book_id            BigInt
  user_id            BigInt

  created_by_user User  @relation(fields: [created_by_user_id], references: [id], name: "Loan_User_created_by_user_id")
  updated_by_user User? @relation(fields: [updated_by_user_id], references: [id], name: "Loan_User_updated_by_user_id")
  book            Book  @relation(fields: [book_id], references: [id], name: "Loan_Book_book_id")
  user            User  @relation(fields: [user_id], references: [id], name: "Loan_User_user_id")

  // authors BookAuthor[] @relation(name: "BookAuthor_Book_book_id")
  // tags    BookTag[]    @relation(name: "BookTag_Book_book_id")

  @@index([status])
  @@map("loan")
}

/**
 * Observações
 */

// Quando uma nova tabela for criada rodar o migrate em 3 etapas:
// 1 > npx prisma migrate dev --name [NOME_AQUI] --schema ./prisma/schema.prisma --create-only
// 2 > [alterações manuais no migration file] 
// 3 > npx prisma migrate dev

// Quando nenhuma tabela for criada rodar o migrate em 1 etapa:
// 1 > npx prisma migrate dev --name [NOME_AQUI] --schema ./prisma/schema.prisma

// Quando for aplicar o migration em produção
// 1 > npx prisma migrate deploy
