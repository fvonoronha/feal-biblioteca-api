# Variáveis de ambiente

# Porta do servidor
PORT = "3000"

NODE_ENV = "development"

PRINT_ROUTES = "true"
PRINT_ROUTES_PATHS = "true"
PRINT_ROUTES_REGEX = "true"
PRINT_REQUESTS = "true"

# Banco de dados. Para ajustar o pool de conexões do Prisma, use os parâmetros de
# query string da própria URL, ex.: "...?schema=public&connection_limit=10&pool_timeout=10"
DATABASE = "postgresql://[username]:[password]@[host]:[port]/[dbname]?schema=public"

# Liga o log de queries do Prisma no console (query/warn/error). Deixe "false" em produção.
PRISMA_LOG = "false"

# Liga/desliga o cron de atualização de estatísticas de acesso (roda de hora em hora).
ENABLE_CRON_JOBS = "true"

# Tamanho máximo aceito para o corpo (JSON) de uma requisição.
JSON_BODY_LIMIT = "1mb"

# Lista separada por vírgulas das origens autorizadas a chamar a API via CORS
# (ex.: "https://biblioteca.feal.org.br,https://admin.feal.org.br").
# Se vazio: fora de produção libera qualquer origem (conveniência de desenvolvimento);
# em produção (NODE_ENV=production) bloqueia todas as origens até isso ser configurado.
CORS_ORIGINS = ""

# Número de rodadas de salt para criptografia de senhas
CRYPTOGRAPHY_ROUNDS_OF_SALT = "10"

# Chave secreta usada para assinar JWTs e para derivar a chave de criptografia AES
# (pode ter qualquer tamanho, uma chave de 256 bits é derivada dela via SHA-256)
CRYPTOGRAPHY_SECRET = "[secret]"

# Por quanto tempo um JWT emitido no login continua válido (formato aceito pela lib "jsonwebtoken")
JWT_EXPIRES_IN = "7d"

# Chave da API do Google Gemini, usada pelo módulo de enriquecimento de metadados via IA
GEMINI_API_KEY = "[gemini-api-key]"

# URL pública do frontend (site da biblioteca), usada nos links enviados por e-mail
# e como origem padrão de CORS. Pode ser informada com ou sem "https://".
WEB_URL = "biblioteca.feal.org.br"

# Configuração do servidor SMTP usado para enviar e-mails (boas-vindas, etc.)
SMTP_SERVER_HOST = "[smtp-host]"
SMTP_SERVER_PORT = "587"
SMTP_SERVER_USERNAME = "[smtp-username]"
SMTP_SERVER_PASSWORD = "[smtp-password]"
SMTP_SERVER_SECURE = "false"
SMTP_SERVER_FROM_NAME = "FEAL - Biblioteca"
SMTP_SERVER_FROM_ADDRESS = "[from-address]"

# Cloudflare R2 (armazenamento de imagens de capa/autor). O ID da conta e as chaves de
# acesso são gerados em Cloudflare > R2 > Manage API Tokens (permissão de leitura/escrita
# no bucket abaixo). R2_PUBLIC_URL é o domínio público já conectado ao bucket (com ou sem
# "https://") - hoje é "r2.biblioteca.feal.espirita.casa".
R2_ACCOUNT_ID = "[r2-account-id]"
R2_ACCESS_KEY_ID = "[r2-access-key-id]"
R2_SECRET_ACCESS_KEY = "[r2-secret-access-key]"
R2_BUCKET_NAME = "biblioteca-feal"
R2_PUBLIC_URL = "r2.biblioteca.feal.espirita.casa"
